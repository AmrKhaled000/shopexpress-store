# ShopExpress environment
# Copy this file to .env and fill in the values for your store.
# .env is git-ignored — never commit it.

# MongoDB connection string. Always include the database name in the path —
# without it the driver falls back to the "test" database.
MONGODB_URI=mongodb://127.0.0.1:27017/shopexpress

# HTTP port.
PORT=3000

# A long random string used to sign session cookies.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=replace-with-a-long-random-string

# Admin account. Required by the seed (and by the dev bootstrap when no
# admin exists). No default password is stored in this repository.
ADMIN_EMAIL=your-admin@example.com
ADMIN_PASSWORD=replace-with-a-long-random-password

# Optional demo customer created by `npm run seed` (skipped when unset).
DEMO_EMAIL=demo@example.com
DEMO_PASSWORD=replace-with-a-long-random-password

# Transactional email via nodemailer. The store sends from its own Gmail
# account over SMTP — use a Google App Password (Google Account → Security →
# 2-Step Verification → App passwords), NOT the account password.
# Without EMAIL_USER/EMAIL_PASS the emails are skipped with a warning.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=465
EMAIL_SECURE=true
EMAIL_USER=your-gmail@gmail.com
EMAIL_PASS=replace-with-a-google-app-password
MAIL_FROM=your-gmail@gmail.com

# Legacy alternative: SendGrid, used only when EMAIL_USER/EMAIL_PASS are unset.
SENDGRID_API_KEY=

# Public URL used in outgoing email links.
APP_URL=http://localhost:3000

# Set to "production" when deploying behind HTTPS.
NODE_ENV=development
