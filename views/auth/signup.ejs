<%- include('../includes/head', { bodyClass: 'page-auth', pageStyles: ['/css/auth.css'] }) %>

<main id="main-content" class="auth-main">
    <div class="auth-shell">
        <%- include('../includes/auth-aside.ejs') %>

        <section class="auth-panel" aria-labelledby="signup-heading">
            <div class="auth-card">
                <div class="auth-card__header">
                    <p class="eyebrow">Join the shop</p>
                    <h1 id="signup-heading">Create your account</h1>
                    <p>An account keeps your cart in one place and makes ordering quiet and quick.</p>
                </div>

                <%- include('../includes/messages.ejs') %>

                <form class="auth-form" action="/signup" method="POST" data-validate novalidate>
                    <div class="form-field <%= validationErrors.email ? 'is-invalid' : '' %>">
                        <label for="email">Email address</label>
                        <div class="input-wrap">
                            <span class="input-wrap__icon" aria-hidden="true"><%- icon('mail') %></span>
                            <input type="email" name="email" id="email" placeholder="you@example.com" value="<%= form.email %>" autocomplete="email" required <%= validationErrors.email ? 'aria-invalid="true" aria-describedby="email-error"' : '' %>>
                        </div>
                        <p class="field-error" id="email-error"><%= validationErrors.email || 'Enter a valid email address.' %></p>
                    </div>

                    <div class="form-field <%= validationErrors.password ? 'is-invalid' : '' %>">
                        <label for="password">Password</label>
                        <div class="input-wrap">
                            <span class="input-wrap__icon" aria-hidden="true"><%- icon('lock-keyhole') %></span>
                            <input type="password" name="password" id="password" placeholder="At least 6 characters" autocomplete="new-password" data-min-length="6" data-strength-source required <%= validationErrors.password ? 'aria-invalid="true" aria-describedby="password-error"' : '' %>>
                            <button class="password-toggle" type="button" data-password-toggle aria-label="Show password" aria-pressed="false">
                                <span data-password-show aria-hidden="true"><%- icon('eye') %></span>
                                <span data-password-hide aria-hidden="true" hidden><%- icon('eye-off') %></span>
                            </button>
                        </div>
                        <p class="field-error" id="password-error"><%= validationErrors.password || 'Password must be at least 6 characters.' %></p>
                        <div class="password-strength" data-strength hidden>
                            <div class="password-strength__bars" aria-hidden="true">
                                <span></span><span></span><span></span><span></span>
                            </div>
                            <p class="password-strength__label" data-strength-label>Use 6 or more characters.</p>
                        </div>
                    </div>

                    <div class="form-field <%= validationErrors.confirmPassword ? 'is-invalid' : '' %>">
                        <label for="confirmPassword">Confirm password</label>
                        <div class="input-wrap">
                            <span class="input-wrap__icon" aria-hidden="true"><%- icon('lock-keyhole') %></span>
                            <input type="password" name="confirmPassword" id="confirmPassword" placeholder="Repeat your password" autocomplete="new-password" required <%= validationErrors.confirmPassword ? 'aria-invalid="true" aria-describedby="confirm-password-error"' : '' %>>
                            <button class="password-toggle" type="button" data-password-toggle aria-label="Show confirmation password" aria-pressed="false">
                                <span data-password-show aria-hidden="true"><%- icon('eye') %></span>
                                <span data-password-hide aria-hidden="true" hidden><%- icon('eye-off') %></span>
                            </button>
                        </div>
                        <p class="field-error" id="confirm-password-error"><%= validationErrors.confirmPassword || 'Passwords must match.' %></p>
                    </div>

                    <p class="form-note">Your details are only used to keep your cart and order history in one place. No newsletters, no noise.</p>

                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                    <button class="btn btn--lg btn--block" type="submit">
                        <span class="btn__label">Create account</span>
                        <%- icon('arrow-right') %>
                    </button>
                </form>

                <div class="auth-card__footer">
                    <p>Already have an account? <a href="/login">Sign in</a></p>
                </div>
            </div>
        </section>
    </div>
</main>

<%- include('../includes/end') %>
