<%- include('../includes/head', { bodyClass: 'page-auth', pageStyles: ['/css/auth.css'] }) %>

<main id="main-content" class="auth-main">
    <div class="auth-shell">
        <%- include('../includes/auth-aside.ejs') %>

        <section class="auth-panel" aria-labelledby="new-password-heading">
            <div class="auth-card">
                <div class="auth-card__header">
                    <p class="eyebrow">Almost there</p>
                    <h1 id="new-password-heading">Set a new password</h1>
                    <p>Choose something memorable and a little difficult to guess. Then you’re back in.</p>
                </div>

                <%- include('../includes/messages.ejs') %>

                <form class="auth-form" action="/new-password" method="POST" data-validate novalidate>
                    <div class="form-field <%= validationErrors.password ? 'is-invalid' : '' %>">
                        <label for="password">New password</label>
                        <div class="input-wrap">
                            <span class="input-wrap__icon" aria-hidden="true"><%- icon('lock-keyhole') %></span>
                            <input type="password" name="password" id="password" placeholder="At least 6 characters" autocomplete="new-password" data-min-length="6" data-strength-source required <%= validationErrors.password ? 'aria-invalid="true" aria-describedby="password-error"' : '' %>>
                            <button class="password-toggle" type="button" data-password-toggle aria-label="Show password" aria-pressed="false">
                                <span data-password-show aria-hidden="true"><%- icon('eye') %></span>
                                <span data-password-hide aria-hidden="true" hidden><%- icon('eye-off') %></span>
                            </button>
                        </div>
                        <p class="field-error" id="password-error"><%= validationErrors.password || 'Password must be at least 6 characters.' %></p>
                        <div class="password-strength" data-strength hidden>
                            <div class="password-strength__bars" aria-hidden="true">
                                <span></span><span></span><span></span><span></span>
                            </div>
                            <p class="password-strength__label" data-strength-label>Use 6 or more characters.</p>
                        </div>
                    </div>

                    <input type="hidden" name="userId" value="<%= userId %>">
                    <input type="hidden" name="passwordToken" value="<%= passwordToken %>">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                    <button class="btn btn--lg btn--block" type="submit">
                        <span class="btn__label">Update password</span>
                        <%- icon('arrow-right') %>
                    </button>
                </form>

                <div class="auth-card__footer">
                    <p>Remembered it? <a href="/login">Return to sign in</a></p>
                </div>
            </div>
        </section>
    </div>
</main>

<%- include('../includes/end') %>
