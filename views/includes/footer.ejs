<footer class="site-footer">
    <div class="container">
        <div class="site-footer__top">
            <div class="site-footer__brand">
                <a class="brand brand--footer" href="/" aria-label="ShopExpress home">
                    <span class="brand__mark" aria-hidden="true">S<span class="brand__dot"></span></span>
                    <span class="brand__word">ShopExpress</span>
                </a>
                <p class="site-footer__description">Considered objects for everyday living. Selected slowly, made to stay.</p>
                <p class="site-footer__note"><span class="status-dot" aria-hidden="true"></span> Open for orders</p>
            </div>

            <nav class="site-footer__column" aria-label="Shop links">
                <h2>Shop</h2>
                <ul>
                    <li><a href="/products">All products</a></li>
                    <li><a href="/cart">Your cart</a></li>
                    <li><a href="/orders">Order history</a></li>
                </ul>
            </nav>

            <nav class="site-footer__column" aria-label="Company links">
                <h2>Company</h2>
                <ul>
                    <li><a href="/about">About us</a></li>
                    <li><a href="/help">Help &amp; FAQ</a></li>
                    <li><a href="/help#shipping">Shipping</a></li>
                    <li><a href="/help#returns">Returns</a></li>
                </ul>
            </nav>

            <div class="site-footer__column">
                <h2>Account</h2>
                <ul>
                    <% if (isAuthenticated) { %>
                        <li><a href="/orders">Your orders</a></li>
                        <% if (isAdmin) { %><li><a href="/admin/products">Admin studio</a></li><% } %>
                        <li>
                            <form action="/logout" method="post">
                                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                <button class="link-button" type="submit">Sign out</button>
                            </form>
                        </li>
                    <% } else { %>
                        <li><a href="/login">Sign in</a></li>
                        <li><a href="/signup">Create account</a></li>
                        <li><a href="/reset">Reset password</a></li>
                    <% } %>
                </ul>
            </div>
        </div>

        <div class="site-footer__bottom">
            <p>© <%= currentYear %> ShopExpress. All rights reserved.</p>
            <p>Independent shop · Considered goods · Built with care</p>
        </div>
    </div>
</footer>

<dialog class="confirm-dialog" id="confirm-dialog" aria-labelledby="confirm-dialog-title" aria-describedby="confirm-dialog-message">
    <div class="confirm-dialog__inner">
        <div class="confirm-dialog__icon" aria-hidden="true"><%- icon('trash-2') %></div>
        <h2 id="confirm-dialog-title">Confirm this action</h2>
        <p id="confirm-dialog-message">Are you sure you want to continue?</p>
        <div class="confirm-dialog__actions">
            <button class="btn btn--ghost" type="button" data-confirm-cancel>Cancel</button>
            <button class="btn btn--danger" type="button" data-confirm-accept>Confirm</button>
        </div>
    </div>
</dialog>
