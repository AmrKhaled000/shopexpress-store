<%- include('../includes/head', { bodyClass: 'page-product', pageStyles: ['/css/shop.css'] }) %>

<main id="main-content">
    <%- include('../includes/messages.ejs') %>

    <nav class="breadcrumbs" aria-label="Breadcrumb">
        <ol>
            <li><a href="/">Home</a></li>
            <li aria-hidden="true"><%- icon('chevron-right') %></li>
            <li><a href="/products">Products</a></li>
            <li aria-hidden="true"><%- icon('chevron-right') %></li>
            <li><span aria-current="page"><%= product.title %></span></li>
        </ol>
    </nav>

    <article class="product-detail">
        <div class="product-detail__media">
            <figure class="product-detail__figure reveal">
                <img src="<%= product.imageUrl %>" alt="<%= product.title %>" width="800" height="1000" data-product-image data-gallery-main>
                <figcaption class="product-detail__caption">
                    <span>ShopExpress / The collection</span>
                    <span>Object no. <%= product._id.toString().slice(-3).toUpperCase() %></span>
                </figcaption>
            </figure>

            <% const galleryImages = (product.images && product.images.length > 0) ? product.images : (product.imageUrl ? [product.imageUrl] : []); %>
            <% if (galleryImages.length > 1) { %>
                <div class="product-gallery" role="group" aria-label="Product images">
                    <% galleryImages.forEach(function (url, index) { %>
                        <button type="button" class="product-gallery__thumb<%= index === 0 ? ' is-active' : '' %>" data-gallery-thumb="<%= url %>" data-gallery-alt="<%= product.title %> — view <%= index + 1 %>" aria-pressed="<%= index === 0 ? 'true' : 'false' %>">
                            <img src="<%= url %>" alt="<%= product.title %>, view <%= index + 1 %>" width="96" height="120" loading="lazy" decoding="async" data-product-image>
                        </button>
                    <% }); %>
                </div>
            <% } %>

            <div class="product-assurances" aria-label="Product assurances">
                <div class="product-assurance">
                    <%- icon('truck') %>
                    <div><strong>Shipping included</strong><span>Dispatched within 2 business days</span></div>
                </div>
                <div class="product-assurance">
                    <%- icon('rotate-ccw') %>
                    <div><strong>30-day returns</strong><span>If it isn’t right, send it back</span></div>
                </div>
                <div class="product-assurance">
                    <%- icon('shield-check') %>
                    <div><strong>Secure session</strong><span>Your account and cart are protected</span></div>
                </div>
            </div>
        </div>

        <div class="product-detail__info">
            <p class="eyebrow">Considered goods · In the collection</p>
            <h1><%= product.title %></h1>
            <p class="product-detail__price"><%= formatPrice(product.price) %></p>
            <p class="product-detail__description"><%= product.description %></p>

            <div class="product-detail__divider"></div>

            <% if (isAuthenticated) { %>
                <form class="buy-form" action="/cart" method="post" data-lock-submit>
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                    <input type="hidden" name="productId" value="<%= product._id %>">
                    <div class="buy-form__row">
                        <label for="quantity">Quantity</label>
                        <div class="select-wrap select-wrap--quantity">
                            <select id="quantity" name="quantity">
                                <% for (let quantity = 1; quantity <= 10; quantity++) { %>
                                    <option value="<%= quantity %>"><%= quantity %></option>
                                <% } %>
                            </select>
                            <span class="select-wrap__icon" aria-hidden="true"><%- icon('chevron-down') %></span>
                        </div>
                    </div>
                    <% const sizeOptions = Array.isArray(product.sizes) ? product.sizes : []; %>
                    <% if (sizeOptions.length > 0) { %>
                        <div class="buy-form__row">
                            <label for="size">Size</label>
                            <div class="select-wrap">
                                <select id="size" name="size" required>
                                    <option value="" selected disabled>Choose a size</option>
                                    <% sizeOptions.forEach(function (size) { %>
                                        <option value="<%= size %>"><%= size %></option>
                                    <% }); %>
                                </select>
                                <span class="select-wrap__icon" aria-hidden="true"><%- icon('chevron-down') %></span>
                            </div>
                        </div>
                    <% } %>
                    <button class="btn btn--lg btn--block" type="submit">
                        <span class="btn__label">Add to cart</span>
                        <%- icon('shopping-bag') %>
                    </button>
                </form>
            <% } else { %>
                <div class="buy-form">
                    <a class="btn btn--lg btn--block" href="/login">Sign in to add to cart <%- icon('arrow-right') %></a>
                    <p class="buy-form__note">New here? <a href="/signup">Create an account</a> — it takes a moment.</p>
                </div>
            <% } %>

            <div class="product-disclosures">
                <details class="disclosure">
                    <summary>Delivery &amp; returns <%- icon('chevron-down', 'disclosure__chevron') %></summary>
                    <div class="disclosure__body">
                        <p>Orders leave the studio within two business days. Shipping is complimentary on every order. If an object isn’t right for your space, return it within 30 days in its original condition.</p>
                        <p><a href="/help#shipping">Read the shipping details</a> or <a href="/help#returns">see the returns policy</a>.</p>
                    </div>
                </details>
                <details class="disclosure">
                    <summary>The ShopExpress edit <%- icon('chevron-down', 'disclosure__chevron') %></summary>
                    <div class="disclosure__body">
                        <p>Every object in the catalog is chosen for a long, useful life. We favour honest materials, quiet forms, and details you notice only after living with them for a while.</p>
                    </div>
                </details>
                <details class="disclosure">
                    <summary>A question about this object? <%- icon('chevron-down', 'disclosure__chevron') %></summary>
                    <div class="disclosure__body">
                        <p>Start with the <a href="/help">help &amp; information</a> pages for ordering, delivery, returns, and account questions.</p>
                    </div>
                </details>
            </div>

            <a class="text-link product-detail__back" href="/products"><%- icon('arrow-left') %> Back to all products</a>
        </div>
    </article>

    <% if (relatedProducts && relatedProducts.length > 0) { %>
        <section class="section related-products" aria-labelledby="related-heading">
            <div class="section-heading">
                <div>
                    <p class="eyebrow">Keep looking</p>
                    <h2 id="related-heading">More from the collection</h2>
                </div>
                <a class="text-link" href="/products">View all <%- icon('arrow-right') %></a>
            </div>
            <div class="product-grid product-grid--related">
                <% for (let i = 0; i < relatedProducts.length; i++) { %>
                    <%- include('../includes/product-card.ejs', { product: relatedProducts[i], index: i }) %>
                <% } %>
            </div>
        </section>
    <% } %>
</main>

<%- include('../includes/end') %>
